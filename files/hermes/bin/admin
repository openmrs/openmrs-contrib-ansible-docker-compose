#!/usr/bin/env bash
#
# Runs the hermes-admin tool in its container. With no arguments in a terminal it opens the
# interactive interface; otherwise arguments are passed through, e.g.
#   bin/admin agent list
#   bin/admin agent add docs-bot --mcp atlassian_read --slack
#   bin/admin agent compose docs-bot >> snippet.yaml
#
# Works with Docker or Podman (see bin/compose.sh).

set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=compose.sh
. "$(dirname "$0")/compose.sh"

# shellcheck disable=SC2086 # tty_flag is empty or a single flag
compose run --rm $tty_flag admin "$@"
