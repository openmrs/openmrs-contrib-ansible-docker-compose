# Hash passwords with Argon2 instead of the default salted SHA-1 ({SSHA}). Existing hashes in any scheme
# keep working; a password is stored with the new scheme the next time it is written. The OpenMRS ID Keycloak
# rewrites outdated hashes as users log in (the "Upgrade LDAP Password Hash" step).
#
# Each bind against an Argon2 hash uses m KiB of memory (64 MiB here) for about 0.1-0.2s.

dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModulePath: /opt/bitnami/openldap/lib/openldap
olcModuleLoad: argon2.so m=65536 t=3 p=1

dn: olcDatabase={-1}frontend,cn=config
changetype: modify
replace: olcPasswordHash
olcPasswordHash: {ARGON2}

# Without this, a client that replaces userPassword with a plain LDAP modify (rather than the Password Modify
# extended operation) has the password stored in cleartext. No default policy is set, so this enables no
# other password policy behaviour, except for entries that name a policy in pwdPolicySubentry.
dn: olcOverlay=ppolicy,olcDatabase={2}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyHashCleartext: TRUE
