# Argon2 as the default password hash (OpenLDAP's default is {SSHA}). m is KiB of memory per bind.
# Keycloak's ldap-password-rehash step treats {ARGON2} as current; update its config if this changes.

dn: cn=module,cn=config
objectClass: olcModuleList
cn: module
olcModulePath: /opt/bitnami/openldap/lib/openldap
olcModuleLoad: argon2.so m=65536 t=3 p=1

dn: olcDatabase={-1}frontend,cn=config
changetype: modify
replace: olcPasswordHash
olcPasswordHash: {ARGON2}

# Hashes passwords written with a plain modify, which are otherwise stored in cleartext. There's no
# olcPPolicyDefault, so password policies only apply to entries with a pwdPolicySubentry.
dn: olcOverlay=ppolicy,olcDatabase={2}mdb,cn=config
changetype: add
objectClass: olcOverlayConfig
objectClass: olcPPolicyConfig
olcOverlay: ppolicy
olcPPolicyHashCleartext: TRUE
