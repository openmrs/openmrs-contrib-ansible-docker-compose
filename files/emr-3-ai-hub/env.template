# Copy to `.env` (encrypted with ansible-vault in OpenMRS infrastructure).
# Never commit plaintext secrets.

# --- OpenMRS & Database Credentials ---
OMRS_DB_USER=openmrs
OMRS_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Admin credentials used by hub-config-init on startup to reconcile the
# QueryStore service account and ChartSearchAI Global Properties.
OMRS_ADMIN_USER=admin
OMRS_ADMIN_PASSWORD=Admin123

# --- Least-Privileged QueryStore Service Account (created by hub-config-init) ---
QUERYSTORE_USERNAME=med-agent-hub
QUERYSTORE_PASSWORD=CHANGE_ME_QUERYSTORE_SERVICE_PASSWORD

# Shared Bearer token between ChartSearchAI (`OMRS_EXTRA_CHARTSEARCHAI_HUB_APIKEY`)
# and med-agent-hub (`HUB_API_KEY`).
CHARTSEARCH_HUB_API_KEY=CHANGE_ME_HUB_API_KEY

# --- Image Tags & Gateway Port ---
TAG=nightly-chartsearch
HUB_TAG=latest
GATEWAY_PORT=8889

# --- Prebuilt HIV Baseline + Elasticsearch QueryStore ---
# Set HIV_BASELINE_ENABLED=false only if you want an empty fresh installation.
HIV_BASELINE_ENABLED=true
HIV_BASELINE_IMAGE=ghcr.io/pmanko/openclinai-hiv-baseline@sha256:6d828211831ef5bf1d37955bf024bc422383a63b9af728d1fa40e4c1acbd5394
ES_JAVA_OPTS=-Xms1g -Xmx1g
CHARTSEARCHAI_DEMO_DUMP_URL=file:///managed-by-hiv-baseline-init

# --- ChartSearchAI Provider Selection ---
CHARTSEARCH_PROVIDERS_ENABLED=bundled,hub
CHARTSEARCH_PROVIDERS_DEFAULT=hub
CHARTSEARCH_BUNDLED_ENGINE=remote
CHARTSEARCH_BUNDLED_ENDPOINT_URL=http://llama-router:8077/v1/chat/completions
CHARTSEARCH_BUNDLED_MODEL_NAME=gemma-4-12b
HUB_ANCHOR=
HUB_TIMEZONE=UTC

# Optional synthetic-data research accounts (`eval-*` with 14 clinical read privileges).
# Leave empty to skip creating them; set a strong password to provision/update all 7.
EVALUATION_PASSWORD=

# --- LLM Backend Mode A: Self-Hosted llama.cpp Router (default) ---
# med-agent-hub automatically downloads and SHA-256 verifies pinned GGUFs into
# the `llm-models` volume on preload/first request and serves them via `llama-router`.
MED_AGENT_LLM_PROVIDER=openai-compatible
MED_AGENT_LLM_BASE_URL=http://llama-router:8077
MED_AGENT_PRELOAD_MODELS=gemma-4-12b
LLAMA_ROUTER_MODELS_MAX=2
MED_AGENT_TOKENIZER_MODE=auto

# --- LLM Backend Mode B: OpenRouter / Remote OpenAI-Compatible (optional override) ---
# To route med-agent-hub to OpenRouter instead of the in-stack llama-router,
# uncomment the lines below and leave MED_AGENT_PRELOAD_MODELS empty.
# MED_AGENT_LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# MED_AGENT_LLM_MODEL_MAP=
# MED_AGENT_PRELOAD_MODELS=

# Optional remote API key for the legacy/bundled ChartSearchAI remote provider:
OMRS_EXTRA_CHARTSEARCHAI_LLM_REMOTE_APIKEY=
